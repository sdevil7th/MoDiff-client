{
  "name": "modiff-client",
  "private": true,
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run style:audit && npm run test:unit && npm run build && npm run bundle:check",
    "check:ui": "npm run e2e:studio:mocked",
    "e2e:studio:mocked": "playwright test tests/e2e/studio-mocked/studio-mocked.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gallery:run": "node scripts/template-gallery-runner.mjs",
    "gallery:source": "node scripts/template-gallery-source-runner.mjs",
    "gallery:inputs": "node scripts/template-gallery-input-tools.mjs",
    "gallery:coverage": "node scripts/template-gallery-coverage.mjs",
    "gallery:queue": "node scripts/example-generation-queue.mjs",
    "gallery:generate": "node scripts/template-gallery-harness.mjs generate",
    "gallery:verify": "node scripts/template-gallery-harness.mjs verify",
    "lint": "eslint .",
    "style:audit": "node scripts/style-audit.mjs",
    "style:audit:update": "node scripts/style-audit.mjs --write-baseline",
    "test:graph-export": "node --test scripts/flow-graph-export.test.mjs",
    "test:templates": "node --test scripts/modiff-template.test.mjs",
    "test:template-quality": "node --test scripts/template-quality.test.mjs",
    "test:live-qwen-proof": "node --test scripts/live-qwen-proof.test.mjs",
    "test:gallery-harness": "node --test scripts/template-gallery-harness.test.mjs",
    "test:gallery-runner": "node --test scripts/template-gallery-runner.test.mjs",
    "test:gallery-queue": "node --test scripts/example-generation-queue.test.mjs",
    "test:graph-mutations": "node --test scripts/flow-graph-mutations.test.mjs",
    "test:requests": "node --test scripts/node-store-requests.test.mjs scripts/request-boundary.test.mjs scripts/server-actions.test.mjs scripts/shared-store-requests.test.mjs scripts/studio-output-requests.test.mjs",
    "test:run-coordinator": "node --test scripts/run-coordinator.test.mjs",
    "test:styles": "node --test scripts/modiff-style.test.mjs",
    "test:unit": "npm run test:styles && npm run test:templates && npm run test:template-quality && npm run test:live-qwen-proof && npm run test:gallery-harness && npm run test:gallery-runner && npm run test:gallery-queue && npm run test:graph-export && npm run test:graph-mutations && npm run test:requests && npm run test:run-coordinator",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@xyflow/react": "^12.8.4",
    "lucide-react": "^1.20.0",
    "nanoid": "^5.1.16",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.1.4"
  }
}
