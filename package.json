{
  "name": "modiff-client",
  "private": true,
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run theme:tokens:check && tsc -b && vite build",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "check": "npm run lock:integrity && npm run licenses:check && npm run format:check && npm run lint && npm run typecheck && npm run style:audit && npm run test:unit && npm run build && npm run bundle:check",
    "check:acceptance": "npm run lock:integrity && npm run licenses:check && npm run format:check && npm run theme:tokens:check && npm run lint && npm run typecheck && npm run style:audit && npm run test:unit && npm run gallery:verify && npm run gallery:coverage:check && npm run workflows:verify && npm run release:contract:verify && npm run release:qualification:gate && npm run check:ui && npm run release:assets:gate && npm run bundle:check",
    "check:ui": "npm run e2e:shared-controls && npm run e2e:studio:mocked",
    "e2e:studio:mocked": "playwright test tests/e2e/studio-mocked/studio-mocked.spec.ts",
    "e2e:studio:live-backend": "playwright test tests/e2e/live-backend/live-backend.spec.ts",
    "e2e:shared-controls": "playwright test tests/e2e/shared-controls/shared-controls.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gallery:run": "node scripts/template-gallery-runner.mjs",
    "gallery:source": "node scripts/template-gallery-source-runner.mjs",
    "gallery:inputs": "node scripts/template-gallery-input-tools.mjs",
    "gallery:runtime-inputs": "node scripts/template-default-inputs.mjs",
    "gallery:runtime-inputs:check": "node scripts/template-default-inputs.mjs --check",
    "graph-fixer:audit": "node scripts/graph-fixer-library-audit.mjs",
    "gallery:coverage": "npm run gallery:coverage:check",
    "gallery:coverage:check": "node scripts/template-gallery-coverage.mjs",
    "gallery:card-coverage": "node scripts/template-card-coverage.mjs",
    "release:contract:generate": "node scripts/release-contract.mjs",
    "release:contract:verify": "node scripts/release-contract.mjs --check",
    "release:assets:verify": "node scripts/template-asset-release-contract.mjs",
    "release:assets:gate": "node scripts/template-asset-release-contract.mjs --source-only && npm run build && npm run release:assets:verify",
    "release:resources:generate": "node scripts/resource-qualification-report.mjs",
    "release:resources:verify": "node scripts/resource-qualification-report.mjs --check",
    "release:qualification:generate": "npm run release:resources:generate && node scripts/release-candidate-report.mjs",
    "release:qualification:verify": "npm run release:resources:verify && node scripts/release-candidate-report.mjs --check",
    "release:qualification:gate": "npm run release:resources:verify && node scripts/release-candidate-report.mjs --check --require-ready",
    "release:qualification:run": "node scripts/release-qualification-campaign.mjs",
    "release:resources:run": "node scripts/resource-qualification-campaign.mjs",
    "release:hardware:qualify": "node scripts/hardware-qualification.mjs",
    "release:resource:qualify": "node scripts/resource-qualification.mjs",
    "release:template:qualify": "node scripts/template-qualification.mjs",
    "gallery:previews": "node scripts/template-card-previews.mjs",
    "gallery:assets:inventory": "node scripts/run-python.mjs scripts/template-gallery-assets.py inventory",
    "gallery:assets:verify": "node scripts/run-python.mjs scripts/template-gallery-assets.py verify",
    "gallery:queue": "node scripts/example-generation-queue.mjs",
    "gallery:generate": "node scripts/template-gallery-harness.mjs generate && npm run gallery:coverage:check",
    "gallery:verify": "node scripts/template-gallery-harness.mjs verify",
    "gallery:repair-evidence": "node scripts/template-gallery-repair-evidence.mjs",
    "workflows:generate": "node scripts/workflow-library-generator.mjs",
    "workflows:verify": "node scripts/workflow-library-verify.mjs",
    "theme:tokens": "node scripts/theme-tokens.mjs",
    "theme:tokens:check": "node scripts/theme-tokens.mjs --check",
    "lint": "eslint .",
    "licenses:check": "node scripts/production-licenses.mjs",
    "licenses:generate": "node scripts/production-licenses.mjs --write",
    "lock:integrity": "node scripts/package-lock-integrity.mjs",
    "style:audit": "node scripts/style-audit.mjs",
    "style:audit:update": "node scripts/style-audit.mjs --write-baseline",
    "test:graph-export": "node --test scripts/flow-graph-export.test.mjs",
    "test:templates": "node --test scripts/modiff-template.test.mjs",
    "test:template-assets:local": "node --test scripts/template-default-inputs.test.mjs",
    "test:template-quality": "node --test scripts/template-quality.test.mjs",
    "test:live-qwen-proof": "node --test scripts/live-qwen-proof.test.mjs scripts/hardware-qualification.test.mjs scripts/release-qualification-policy.test.mjs scripts/resource-qualification.test.mjs scripts/resource-qualification-campaign.test.mjs scripts/template-qualification.test.mjs scripts/release-qualification-campaign.test.mjs",
    "test:release-contract": "node --test scripts/backend-installer-contract.test.mjs scripts/backend-node-registry.test.mjs scripts/release-contract.test.mjs scripts/template-asset-release-contract.test.mjs",
    "test:live-backend-contract": "node scripts/live-backend-contract.mjs",
    "test:gallery-harness": "node --test scripts/template-gallery-harness.test.mjs",
    "test:gallery-runner": "node --test scripts/template-gallery-runner.test.mjs",
    "test:gallery-queue": "node --test scripts/example-generation-queue.test.mjs",
    "test:driver-contract": "node --test scripts/hugging-face-runtime-contract.test.mjs",
    "test:graph-mutations": "node --test scripts/flow-graph-mutations.test.mjs scripts/graph-fixer.test.mjs",
    "test:graph-visuals": "node --test scripts/graph-visuals.test.mjs",
    "test:media-viewer": "node --test scripts/media-viewer.test.mjs",
    "test:requests": "node --test scripts/node-store-requests.test.mjs scripts/request-boundary.test.mjs scripts/server-actions.test.mjs scripts/shared-store-requests.test.mjs scripts/studio-output-requests.test.mjs",
    "test:run-coordinator": "node --test scripts/run-coordinator.test.mjs scripts/run-issue-store.test.mjs",
    "test:run-activity": "node --test scripts/run-activity.test.mjs",
    "test:template-input-preview": "node --test scripts/template-input-preview.test.mjs",
    "test:asset-storage": "node --test scripts/template-assets.test.mjs && node scripts/run-python.mjs scripts/template-gallery-assets.test.py",
    "test:workflow-save": "node --test scripts/workflow-save.test.mjs",
    "test:styles": "node --test scripts/modiff-style.test.mjs",
    "test:unit": "npm run test:styles && npm run test:templates && npm run test:template-quality && npm run gallery:card-coverage && npm run test:release-contract && npm run test:live-qwen-proof && npm run test:gallery-harness && npm run test:gallery-runner && npm run test:gallery-queue && npm run test:driver-contract && npm run test:graph-export && npm run test:graph-mutations && npm run test:graph-visuals && npm run test:media-viewer && npm run test:requests && npm run test:run-coordinator && npm run test:run-activity && npm run test:template-input-preview && npm run test:asset-storage && npm run test:workflow-save",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@xyflow/react": "^12.8.4",
    "lucide-react": "^1.20.0",
    "nanoid": "^5.1.16",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.5",
    "terser": "^5.48.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.1.4"
  }
}
